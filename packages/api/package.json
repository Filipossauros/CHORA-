{
  "name": "@chora/api",
  "version": "1.0.0",
  "description": "CHORA+ — API REST (Fastify) com persistência em memória atrás de interfaces de repositório.",
  "type": "module",
  "main": "./src/server.ts",
  "exports": {
    ".": "./src/server.ts",
    "./nucleo": "./src/nucleo.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "seed": "tsx src/seed/main-seed.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chora/domain": "workspace:*",
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "fastify": "^4.28.1",
    "luxon": "^3.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2"
  }
}
