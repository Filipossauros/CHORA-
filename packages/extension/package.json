{
  "name": "@chora/extension",
  "version": "1.0.0",
  "description": "CHORA+ — extensão Azure DevOps (React) com as três vistas: registo de tempo, aprovações e área do gestor.",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development --port 3000",
    "preview": "webpack serve --config webpack.preview.cjs --mode development",
    "preview:build": "webpack --config webpack.preview.cjs --mode production",
    "pages:build": "webpack --config webpack.pages.cjs --mode production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "tfx extension create --manifest-globs vss-extension.json",
    "test": "echo \"sem testes automáticos no protótipo (secção 12.2: componentes)\" && exit 0",
    "test:run": "echo \"sem testes automáticos no protótipo\" && exit 0"
  },
  "dependencies": {
    "@chora/api": "workspace:*",
    "@chora/domain": "workspace:*",
    "azure-devops-extension-sdk": "^4.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "html-webpack-plugin": "^5.6.3",
    "ts-loader": "^9.5.1",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  }
}
